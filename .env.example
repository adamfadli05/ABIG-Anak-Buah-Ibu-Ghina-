# URL — sesuaikan dengan environment
# Lokal (tanpa Docker):
# FRONTEND_URL=http://localhost/ABIG-Anak-Buah-Ibu-Ghina-/frontend
# BACKEND_URL=http://localhost/ABIG-Anak-Buah-Ibu-Ghina-/backend
# VPS (Docker):
FRONTEND_URL=http://your-domain.com
BACKEND_URL=http://your-domain.com

# CORS — origins yang diizinkan (dipisah koma, tanpa spasi di sekitar koma)
# Karena frontend & backend satu domain via reverse proxy, cukup satu origin
CORS_ALLOWED_ORIGINS=http://your-domain.com,http://localhost,http://localhost:3000

# Database Supabase — WAJIB diisi, tidak boleh kosong
DB_HOST=aws-0-xx-southeast-x.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your_project_id
DB_PASSWORD=isi_password_supabase_disini

# Google OAuth — isi dengan seluruh isi client_secret.json dalam satu baris
GOOGLE_CLIENT_SECRET={"web":{"client_id":"...","project_id":"...","auth_uri":"...","token_uri":"...","client_secret":"...","redirect_uris":["..."],"javascript_origins":["..."]}}
